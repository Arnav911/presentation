# Backend Configuration Example .env
# Copy this file to '.env' and fill in your actual API keys. Do NOT commit the '.env' file to Git!

# Provider Selection (openai, google, anthropic, ollama, custom)
LLM=anthropic

# OpenAI settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic settings
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google settings
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-1.5-pro

# Advanced Model Settings
EXTENDED_REASONING=false
WEB_GROUNDING=true
DISABLE_THINKING=false

# Image Generation
DISABLE_IMAGE_GENERATION=true
IMAGE_PROVIDER=pexels

# Kling Image Generation (required if IMAGE_PROVIDER=kling)
KLING_API_KEY=your_kling_api_key_here
KLING_SECRET_KEY=your_kling_secret_key_here

# Other Services
TAVILY_API_KEY=your_tavily_api_key_here
# COMFYUI_URL=
# PIXABAY_API_KEY=
# PEXELS_API_KEY=
